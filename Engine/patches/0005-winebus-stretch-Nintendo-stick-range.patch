+/* Parable: Nintendo controllers report full tilt at roughly 85-90% of the axis
+ * range, and SDL passes that on unchanged. XInput games expect full tilt to
+ * reach the end of the range; Dark Souls, for one, treats ~88% as walking pace
+ * and won't sprint. Stretch those sticks so full tilt reads as full. */
+static int scale_stick(struct sdl_device *impl, int axis, int value)
+{
+    long long scaled;
+
+    if (impl->stick_gain == 100 || axis > SDL_CONTROLLER_AXIS_RIGHTY) return value;
+    scaled = (long long)value * impl->stick_gain / 100;
+    if (scaled > 32767) return 32767;
+    if (scaled < -32768) return -32768;
+    return scaled;
+}
+
 static inline struct sdl_device *impl_from_unix_device(struct unix_device *iface)
 {
     return CONTAINING_RECORD(iface, struct sdl_device, unix_device);
