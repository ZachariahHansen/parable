+/* Parable: Retina mode presents a display's original mode to Windows at twice
+ * its size in points, which is its true pixel size only on a Retina display. On
+ * an ordinary monitor it made Windows believe a 1920x1080 screen was 3840x2160,
+ * so games asking for 1920x1080 switched the monitor to a lower refresh rate of
+ * the same size, which also turned Retina mode off mid-game and left the game
+ * drawn at twice the size of the screen. Only double modes that are Retina. */
+static BOOL retina_doubles(const struct display_mode_descriptor* desc)
+{
+    return retina_enabled && desc && desc->pixel_width > desc->width;
 }
 
 
