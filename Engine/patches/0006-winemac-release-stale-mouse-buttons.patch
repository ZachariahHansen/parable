+        // Parable: the release that pairs with the activating click can arrive
+        // late or not at all, so keep checking while we're the active app.
+        [self releaseStaleMouseButtons];
+        [staleButtonTimer invalidate];
+        staleButtonTimer = [NSTimer scheduledTimerWithTimeInterval:0.25
+                                                            target:self
+                                                          selector:@selector(releaseStaleMouseButtons)
+                                                          userInfo:nil
+                                                           repeats:YES];
     }
 
