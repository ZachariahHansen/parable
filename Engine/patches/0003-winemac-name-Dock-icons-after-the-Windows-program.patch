+
+/***********************************************************************
+ *              macdrv_set_process_name
+ *
+ * Parable: remember the name the Dock should show for this process. Wine runs
+ * every Windows program from one unbundled executable, so without this they
+ * are all labelled "wine".
+ */
+static NSString *process_display_name;
+
+void macdrv_set_process_name(CFStringRef name)
+{
+    NSString *copy = [(NSString *)name copy];
+    [process_display_name release];
+    process_display_name = copy;
+}
+
+/* The display name of a running app belongs to LaunchServices, and the only
+ * way to change it for a process without a bundle is through these calls. They
+ * are looked up at runtime so that a system without them just keeps "wine". */
+static void apply_process_name(void)
+{
+    CFBundleRef services = CFBundleGetBundleWithIdentifier(CFSTR("com.apple.LaunchServices"));
+    CFTypeRef (*get_asn)(void);
+    OSStatus (*set_item)(int, CFTypeRef, CFStringRef, CFStringRef, CFDictionaryRef *);
+    CFStringRef *display_name_key;
+    CFTypeRef asn;
+
+    if (!process_display_name || !services) return;
+    get_asn = CFBundleGetFunctionPointerForName(services, CFSTR("_LSGetCurrentApplicationASN"));
+    set_item = CFBundleGetFunctionPointerForName(services, CFSTR("_LSSetApplicationInformationItem"));
+    display_name_key = CFBundleGetDataPointerForName(services, CFSTR("_kLSDisplayNameKey"));
+    if (!get_asn || !set_item || !display_name_key) return;
+
+    if ((asn = get_asn()))
+        set_item(-2 /* current session */, asn, *display_name_key, (CFStringRef)process_display_name, NULL);
 }
 
